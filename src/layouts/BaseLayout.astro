---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { htmlLang, localePath, ogLocale, otherLocale, segments, useUi, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Equivalent page per language (absolute paths). Missing language: no translation. */
  alternates: Partial<Record<Locale, string>>;
  type?: 'website' | 'article';
  pubDate?: Date;
  noindex?: boolean;
}

const { locale, title, description, alternates, type = 'website', pubDate, noindex } = Astro.props;
const ui = useUi(locale);
const site = Astro.site!;
const canonical = new URL(alternates[locale] ?? Astro.url.pathname, site);
const homes = { fr: localePath('fr', ''), en: localePath('en', '') };
const fullTitle = title === ui.siteTitle ? title : `${title} · ${ui.siteTitle}`;
const xDefault = alternates.fr ?? alternates[locale];
const other = otherLocale(locale);
const rss = locale === 'fr' ? '/rss.xml' : '/en/rss.xml';
---
<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {Object.entries(alternates).map(([code, path]) => (
      <link rel="alternate" hreflang={code} href={new URL(path, site)} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, site)} />}
    <link rel="alternate" type="application/rss+xml" title={`${ui.siteTitle} (RSS)`} href={rss} />
    <link rel="sitemap" href={locale === 'fr' ? '/sitemap-fr.xml' : '/sitemap-en.xml'} />

    <meta property="og:site_name" content={ui.siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {alternates[other] && <meta property="og:locale:alternate" content={ogLocale[other]} />}
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var theme;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={homes[locale]}>{ui.siteTitle}</a>
      <nav aria-label="Navigation">
        <a href={localePath(locale, segments.blog[locale])}>{ui.nav.blog}</a>
        <a href={localePath(locale, segments.about[locale])}>{ui.nav.about}</a>
      </nav>
      <div class="header-tools">
        <LanguageSwitcher locale={locale} alternates={alternates} homes={homes} />
        <ThemeToggle locale={locale} />
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {ui.siteTitle} · {ui.footer.rights}</p>
      <p><a href={rss}>{ui.footer.rss}</a></p>
    </footer>
  </body>
</html>
