---
import TagPage from '../../page-components/TagPage.astro';
import { getTags } from '../../lib/posts';

export async function getStaticPaths() {
  return (await getTags('fr')).map(({ tag }) => ({ params: { tag }, props: { tag } }));
}
const { tag } = Astro.props;
---
<TagPage locale="fr" tag={tag} />
