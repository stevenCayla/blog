---
import PostPage from '../../page-components/PostPage.astro';
import { getPosts, postSlug } from '../../lib/posts';

export async function getStaticPaths() {
  return (await getPosts('fr')).map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}
const { post } = Astro.props;
---
<PostPage post={post} />
