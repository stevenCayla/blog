---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { localePath, otherLocale, segments, useUi, type Locale } from '../i18n';
import { getPosts } from '../lib/posts';

const { locale } = Astro.props as { locale: Locale };
const ui = useUi(locale);
const other = otherLocale(locale);
const latest = (await getPosts(locale)).slice(0, 5);
const otherCount = (await getPosts(other)).length;
---
<BaseLayout
  locale={locale}
  title={ui.siteTitle}
  description={ui.siteDescription}
  alternates={{ fr: localePath('fr', ''), en: localePath('en', '') }}
>
  <h1>{ui.siteTitle}</h1>
  <p>{ui.siteDescription}</p>

  <h2>{ui.home.latest}</h2>
  <div class="post-list">
    {latest.map((post) => <PostCard post={post} locale={locale} />)}
  </div>
  <p><a href={localePath(locale, segments.blog[locale])}>{ui.home.allPosts}</a></p>

  <aside class="notice">
    <p>
      {ui.home.otherLanguage(otherCount)}
      {otherCount > 0 && <a href={localePath(other, segments.blog[other])} hreflang={other}>{ui.home.otherLanguageLink}</a>}
    </p>
  </aside>
</BaseLayout>
